# Copy this file to .env and fill in real values
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Use sqlite by default (no setup needed). Switch to postgres for production.
USE_POSTGRES=False
POSTGRES_DB=cartpulse
POSTGRES_USER=cartpulse
POSTGRES_PASSWORD=cartpulse
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
